{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist"      // << Add this line
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "lib", "**/*.spec.ts"]
}
