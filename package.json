{
  "name": "ironaai",
  "version": "0.0.13",
  "main": "dist/index.js",
  "module": "dist/index.m.js",
  "unpkg": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && microbundle --tsconfig tsconfig.json --target node --no-sourcemap",
    "devsdk": "microbundle --watch --tsconfig tsconfig.json --no-sourcemap",
    "dev": "ts-node-dev -r tsconfig-paths/register src/server.ts",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
    "eg-test": "npm run build && npm link && cd example && npm link ironaai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Irona-ai/irona-node-sdk"
  },
  "bugs": {
    "url": "https://github.com/Irona-ai/irona-node-sdk/issues"
  },
  "homepage": "https://github.com/Irona-ai/irona-node-sdk/blob/main/README.md",
  "keywords": [
    "irona",
    "irona.ai",
    "ironaai",
    "llm router",
    "best llm router",
    "unified llm router",
    "best unified llm router",
    "intelligent llm router",
    "ai based llm router",
    "intelligent router"
  ],
  "author": "Chandraprakash Pal <chandraprakash@irona.ai>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "description": "Irona AI provides intelligent routing for your queries, dynamically selecting the best language model based on criteria like cost, latency, and efficiency. Our SDK offers clients the flexibility to choose from a variety of LLM models, while also providing a unified interface for seamless interactions. This enables efficient, tailored, and cost-effective solutions for conversational AI, ensuring that each query is handled by the most suitable model for optimal performance.",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.19",
    "@ai-sdk/mistral": "^1.2.8",
    "@ai-sdk/openai": "^1.3.22",
    "@ai-sdk/perplexity": "^1.1.9",
    "@ai-sdk/togetherai": "^0.2.14",
    "ai": "^4.3.16",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.5",
    "jest": "^29.7.0",
    "microbundle": "^0.15.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
