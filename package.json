{
  "name": "ironlabs",
  "version": "2.1.2",
  "main": "dist/index.js",
  "module": "dist/index.m.js",
  "unpkg": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && microbundle --tsconfig tsconfig.json --target node --no-sourcemap",
    "devsdk": "microbundle --watch --tsconfig tsconfig.json --no-sourcemap",
    "dev": "ts-node-dev -r tsconfig-paths/register src/server.ts",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "eg-test": "npm run build && npm link && cd example && npm link ironlabs",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "clean": "npm run lint:fix && npm run format:write",
    "validate": "npm run lint && npm run type-check && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Irona-ai/irona-node-sdk"
  },
  "bugs": {
    "url": "https://github.com/Irona-ai/irona-node-sdk/issues"
  },
  "homepage": "https://github.com/Irona-ai/irona-node-sdk/blob/main/README.md",
  "keywords": [
    "ironlabs",
    "ironlabsai",
    "irona",
    "ironlabs.ai",
    "ironaai",
    "llm router",
    "best llm router",
    "unified llm router",
    "best unified llm router",
    "intelligent llm router",
    "ai based llm router",
    "intelligent router"
  ],
  "author": "Chandraprakash Pal <chandraprakash@ironlabs.ai>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "description": "Ironlabs AI provides intelligent routing for your queries, dynamically selecting the best language model based on criteria like cost, latency, and efficiency. Our SDK offers clients the flexibility to choose from a variety of LLM models, while also providing a unified interface for seamless interactions. This enables efficient, tailored, and cost-effective solutions for conversational AI, ensuring that each query is handled by the most suitable model for optimal performance.",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.17",
    "@ai-sdk/google": "^2.0.15",
    "@ai-sdk/mistral": "^2.0.15",
    "@ai-sdk/openai": "^2.0.102",
    "@ai-sdk/perplexity": "^2.0.9",
    "@ai-sdk/togetherai": "^1.0.18",
    "@ai-sdk/xai": "^2.0.23",
    "ai": "^5.0.48",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "microbundle": "^0.15.1",
    "prettier": "3.7.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
