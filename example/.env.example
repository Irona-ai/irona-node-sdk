# Select Model
BASE_URL='https://app.irona.ai'
IRONAAI_API_KEY='IRONAAI_API_KEY' # generate your API key at https://app.irona.ai

# Completions — set the key(s) for the provider(s) you use
OPENAI_API_KEY='OPENAI_API_KEY' # generate your API key at https://openai.com/api
TOGETHER_API_KEY='TOGETHER_API_KEY' # generate your API key at https://api.together.ai
REPLICATE_API_KEY='REPLICATE_API_KEY' # generate your API key at https://replicate.com
ANTHROPIC_API_KEY='ANTHROPIC_API_KEY' # generate your API key at https://anthropic.com
GOOGLE_API_KEY='GOOGLE_API_KEY' # generate your API key at https://ai.google.dev/
MISTRAL_API_KEY='MISTRAL_API_KEY' # generate your API key at https://console.mistral.ai/
PPLX_API_KEY='PPLX_API_KEY' # generate your API key at https://console.pplx.ai/

# Optional OpenAI-compatible gateway (OpenRouter, Requesty, LLM Gateway, etc.)
# Uncomment ONE of the following base URL examples:
# LLM_GATEWAY_BASE_URL='https://openrouter.ai/api/v1'    # OpenRouter
# LLM_GATEWAY_BASE_URL='https://router.requesty.ai/v1'   # Requesty
# LLM_GATEWAY_BASE_URL='https://api.llmgateway.io/v1'    # LLM Gateway
LLM_GATEWAY_API_KEY='your-gateway-api-key'
LLM_GATEWAY_INCLUDE_PROVIDER_IN_MODEL_NAME='true' # true for OpenRouter/Requesty, false for LLM Gateway

# OpenRouter-specific env fallbacks (optional, alternative to LLM_GATEWAY_* above)
# OPENROUTER_API_KEY='your-openrouter-key'
# OPENROUTER_HTTP_REFERER='https://your-app.example'
# OPENROUTER_X_TITLE='Your App Name'

# Router configuration (optional — defaults to Irona router)
# ROUTER_TYPE='irona'                                              # 'irona' (default), 'api', or 'local'
# ROUTER_BASE_URL='https://api.notdiamond.ai/v2/modelRouter'      # Required if ROUTER_TYPE=api
# ROUTER_API_KEY='nd_xxx'                                          # Required if ROUTER_TYPE=api
# ROUTER_ENDPOINT='/modelSelect'                                   # Optional endpoint path for API router

SUPPORTED_MODELS_URL='SUPPORTED_MODELS_URL' # optional override for supported models URL
