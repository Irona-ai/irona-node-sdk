# Select Model
BASE_URL='https://app.ironlabs.ai'
IRONLABS_API_KEY = 'IRONLABS_API_KEY' # generate your API key at https://app.ironlabs.ai
# Legacy fallback names still accepted: IRONLABS_AI_API_KEY, IRONAAI_API_KEY
# Completions
OPENAI_API_KEY= 'OPENAI_API_KEY' # generate your API key at https://openai.com/api
TOGETHER_API_KEY= 'TOGETHER_API_KEY' # generate your API key at https://api.together.ai
REPLICATE_API_KEY= 'REPLICATE_API_KEY' # generate your API key at https://replicate.com
ANTHROPIC_API_KEY= 'ANTHROPIC_API_KEY' # generate your API key at https://anthropic.com
GOOGLE_API_KEY= 'GOOGLE_API_KEY' # generate your API key at https://ai.google.dev/
MISTRAL_API_KEY= 'MISTRAL_API_KEY' # generate your API key at https://console.mistral.ai/
PPLX_API_KEY= 'PPLX_API_KEY' # generate your API key at https://console.pplx.ai/

# Optional OpenAI-compatible gateway (OpenRouter, LLM Gateway, Requesty, etc.)
#
# Use ONE canonical URL var — `GATEWAY_BASE_URL` — for any gateway. The SDK
# detects which flavour from the hostname and picks the matching API key from
# the provider-specific env vars below:
#   - openrouter.ai      → uses OPENROUTER_API_KEY,    `plugins:[{id:'web'}]` for search
#   - api.llmgateway.io  → uses LLM_GATEWAY_API_KEY,   `web_search:true`, bare model names
#
# Default: when GATEWAY_BASE_URL is unset, OpenRouter is used if OPENROUTER_API_KEY is set.
# GATEWAY_BASE_URL='https://openrouter.ai/api/v1'   # OpenRouter (default)
# GATEWAY_BASE_URL='https://api.llmgateway.io/v1'   # LLM Gateway
# GATEWAY_BASE_URL='https://router.requesty.ai/v1'  # Requesty

# API keys for gateways. The SDK picks the matching key based on GATEWAY_BASE_URL's hostname.
# Use GATEWAY_API_KEY as a common key for any gateway (especially custom/other endpoints).
# Provider-specific keys take priority over the common key for their respective gateways.
# GATEWAY_API_KEY='your-gateway-key'          # common key — works for any OpenAI-compatible gateway
# OPENROUTER_API_KEY='your-openrouter-key'    # takes priority for openrouter.ai
# LLM_GATEWAY_API_KEY='your-llm-gateway-key' # takes priority for api.llmgateway.io

LLM_GATEWAY_INCLUDE_PROVIDER_IN_MODEL_NAME='true' # true for OpenRouter/Requesty (provider/model); ignored for LLM Gateway (always bare names)

# Legacy URL fallbacks (still supported if GATEWAY_BASE_URL is unset):
# LLM_GATEWAY_BASE_URL='https://api.llmgateway.io/v1'
# OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'
# OPENROUTER_HTTP_REFERER='https://your-app.example'
# OPENROUTER_X_TITLE='Your App Name'

# TODO: FIX & Share ENV VARs
# Router configuration (optional — defaults to Irona router)
# ROUTER_TYPE='irona'                                              # 'irona' (default), 'api', or 'local'
# ROUTER_BASE_URL='https://api.ironlabs.ai/v2/'      # Required if ROUTER_TYPE=api
# ROUTER_API_KEY='nd_xxx'                                          # Required if ROUTER_TYPE=api
# ROUTER_ENDPOINT='/modelSelect'                                   # Optional endpoint path for API router

SUPPORTED_MODELS_URL='SUPPORTED_MODELS_URL' # URL to fetch supported models this is optional
